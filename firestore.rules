rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================================================
    // 共通関数
    // ==================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validPublicId(publicId) {
      return publicId is string
        && publicId.size() >= 3
        && publicId.size() <= 20
        && publicId.matches('^[a-z0-9_]+$');
    }

    function validProfile(data) {
      return data.keys().hasAll([
          'displayName',
          'publicId',
          'profileText',
          'sharingEnabled',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'displayName',
          'publicId',
          'profileText',
          'sharingEnabled',
          'createdAt',
          'updatedAt'
        ])
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 30
        && validPublicId(data.publicId)
        && data.profileText is string
        && data.profileText.size() <= 200
        && data.sharingEnabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validPairId(
      pairId,
      firstUserId,
      secondUserId
    ) {
      return firstUserId is string
        && secondUserId is string
        && firstUserId != secondUserId
        && (
          (
            firstUserId < secondUserId
            && pairId == firstUserId + '_' + secondUserId
          )
          ||
          (
            secondUserId < firstUserId
            && pairId == secondUserId + '_' + firstUserId
          )
        );
    }

    function validLocation(data) {
      return data.keys().hasAll([
          'latitude',
          'longitude',
          'accuracy',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'latitude',
          'longitude',
          'accuracy',
          'updatedAt'
        ])
        && data.latitude is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180
        && data.longitude <= 180
        && data.accuracy is number
        && data.accuracy >= 0
        && data.updatedAt is timestamp;
    }

    // ==================================================
    // users
    // ==================================================

    match /users/{userId} {

      // ログインユーザーはプロフィールを取得できる。
      allow read: if signedIn();

      // 自分のプロフィールだけ作成できる。
      allow create: if isOwner(userId)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(
          /databases/$(database)/documents/public_ids/$(request.resource.data.publicId)
        ).data.userId == userId;

      // 自分のプロフィールだけ更新できる。
      allow update: if isOwner(userId)
        && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'profileText',
            'sharingEnabled',
            'updatedAt'
          ])
        && request.resource.data.updatedAt == request.time;

      // アカウント削除フェーズで変更する。
      allow delete: if false;
    }

    // ==================================================
    // public_ids
    // ==================================================

    match /public_ids/{publicId} {

      // 友達検索で利用する。
      allow read: if signedIn();

      // 自分の公開IDだけ作成できる。
      allow create: if signedIn()
        && validPublicId(publicId)
        && request.resource.data.keys().hasAll([
          'userId',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId',
          'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && !exists(
          /databases/$(database)/documents/public_ids/$(publicId)
        )
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.publicId == publicId;

      // MVPでは公開IDは変更しない。
      allow update, delete: if false;
    }

    // ==================================================
    // friend_requests
    // ==================================================

    match /friend_requests/{requestId} {

      // Transactionで申請の存在確認を行うための単体取得。
      allow get: if signedIn()
        && (
          !exists(
            /databases/$(database)/documents/friend_requests/$(requestId)
          )
          || resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );

      // 自分が関係している申請だけ一覧取得できる。
      allow list: if signedIn()
        && (
          resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );

      // 友達申請作成。
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'senderId',
          'receiverId',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'senderId',
          'receiverId',
          'createdAt'
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.senderId
          != request.resource.data.receiverId
        && validPairId(
          requestId,
          request.resource.data.senderId,
          request.resource.data.receiverId
        )
        && request.resource.data.createdAt == request.time
        && exists(
          /databases/$(database)/documents/users/$(request.resource.data.senderId)
        )
        && exists(
          /databases/$(database)/documents/users/$(request.resource.data.receiverId)
        )
        && !exists(
          /databases/$(database)/documents/friendships/$(requestId)
        );

      // 申請そのものの内容は変更させない。
      allow update: if false;

      // 送信者は取り消し、
      // 受信者は拒否・承認時に削除できる。
      allow delete: if signedIn()
        && (
          resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );
    }

    // ==================================================
    // friendships
    // ==================================================

    match /friendships/{friendshipId} {

      // Transactionで友達関係の存在確認を行うための単体取得。
      allow get: if signedIn()
        && (
          !exists(
            /databases/$(database)/documents/friendships/$(friendshipId)
          )
          || request.auth.uid in resource.data.userIds
        );

      // userIds array-contains 自分のUID
      // というクエリで友達一覧を取得する。
      allow list: if signedIn()
        && request.auth.uid in resource.data.userIds;

      // 申請を受け取った本人だけが友達関係を作成できる。
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'userIds',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userIds',
          'createdAt'
        ])
        && request.resource.data.userIds is list
        && request.resource.data.userIds.size() == 2
        && request.resource.data.userIds[0]
          != request.resource.data.userIds[1]
        && validPairId(
          friendshipId,
          request.resource.data.userIds[0],
          request.resource.data.userIds[1]
        )
        && request.resource.data.createdAt == request.time
        && exists(
          /databases/$(database)/documents/friend_requests/$(friendshipId)
        )
        && get(
          /databases/$(database)/documents/friend_requests/$(friendshipId)
        ).data.receiverId == request.auth.uid
        && request.resource.data.userIds.hasAll([
          get(
            /databases/$(database)/documents/friend_requests/$(friendshipId)
          ).data.senderId,
          get(
            /databases/$(database)/documents/friend_requests/$(friendshipId)
          ).data.receiverId
        ]);

      allow update: if false;

      // 友達になっているどちらか一方が解除できる。
      allow delete: if signedIn()
        && request.auth.uid in resource.data.userIds;
    }

    // ==================================================
    // locations
    // ==================================================

    match /locations/{userId} {

      // 現時点では自分の位置だけ取得できる。
      //
      // 次のマップフェーズで、
      // 承認済みの友達からの読み取りを追加する。
      allow get: if isOwner(userId);

      // 他ユーザーの位置一覧取得はまだ禁止。
      allow list: if false;

      // 自分の位置だけ作成・更新できる。
      // さらに位置共有がONであることを確認する。
      allow create, update: if isOwner(userId)
        && validLocation(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && getAfter(
          /databases/$(database)/documents/users/$(userId)
        ).data.sharingEnabled == true;

      // 共有OFF時に自分の位置を削除できる。
      allow delete: if isOwner(userId);
    }

    // ==================================================
    // その他
    // ==================================================

    // 明示的に許可していないデータへのアクセスは禁止。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}