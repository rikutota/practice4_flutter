rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================================================
    // 共通関数
    // ==================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn()
        && request.auth.uid == userId;
    }

    function validPublicId(publicId) {
      return publicId is string
        && publicId.size() >= 3
        && publicId.size() <= 20
        && publicId.matches('^[a-z0-9_]+$');
    }

    function validProfile(data) {
      return data.keys().hasAll([
          'displayName',
          'publicId',
          'profileText',
          'sharingEnabled',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'displayName',
          'publicId',
          'profileText',
          'sharingEnabled',
          'createdAt',
          'updatedAt'
        ])
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 30
        && validPublicId(data.publicId)
        && data.profileText is string
        && data.profileText.size() <= 200
        && data.sharingEnabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validPairId(
      pairId,
      firstUserId,
      secondUserId
    ) {
      return firstUserId is string
        && secondUserId is string
        && firstUserId != secondUserId
        && (
          (
            firstUserId < secondUserId
            && pairId
              == firstUserId
                + '_'
                + secondUserId
          )
          ||
          (
            secondUserId < firstUserId
            && pairId
              == secondUserId
                + '_'
                + firstUserId
          )
        );
    }

    function validLocation(data) {
      return data.keys().hasAll([
          'latitude',
          'longitude',
          'accuracy',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'latitude',
          'longitude',
          'accuracy',
          'updatedAt'
        ])
        && data.latitude is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180
        && data.longitude <= 180
        && data.accuracy is number
        && data.accuracy >= 0
        && data.updatedAt is timestamp;
    }

    function isFriend(userId) {
      let friendshipId =
        request.auth.uid < userId
          ? request.auth.uid
            + '_'
            + userId
          : userId
            + '_'
            + request.auth.uid;

      return signedIn()
        && request.auth.uid != userId
        && exists(
          /databases/$(database)/documents/friendships/$(friendshipId)
        );
    }

    // ==================================================
    // users
    // ==================================================

    match /users/{userId} {

      allow read: if signedIn();

      allow create: if isOwner(userId)
        && validProfile(
          request.resource.data
        )
        && request.resource.data.createdAt
          == request.time
        && request.resource.data.updatedAt
          == request.time
        && getAfter(
          /databases/$(database)/documents/public_ids/$(request.resource.data.publicId)
        ).data.userId == userId;

      allow update: if isOwner(userId)
        && validProfile(
          request.resource.data
        )
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'profileText',
            'sharingEnabled',
            'updatedAt'
          ])
        && request.resource.data.updatedAt
          == request.time;

      // アカウント削除時のみ本人が削除できる。
      allow delete: if isOwner(userId);
    }

    // ==================================================
    // public_ids
    // ==================================================

    match /public_ids/{publicId} {

      allow read: if signedIn();

      allow create: if signedIn()
        && validPublicId(publicId)
        && request.resource.data.keys()
          .hasAll([
            'userId',
            'createdAt'
          ])
        && request.resource.data.keys()
          .hasOnly([
            'userId',
            'createdAt'
          ])
        && request.resource.data.userId
          == request.auth.uid
        && request.resource.data.createdAt
          == request.time
        && !exists(
          /databases/$(database)/documents/public_ids/$(publicId)
        )
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.publicId == publicId;

      allow update: if false;

      // 公開IDを所有する本人だけ削除できる。
      allow delete: if signedIn()
        && resource.data.userId
          == request.auth.uid;
    }

    // ==================================================
    // friend_requests
    // ==================================================

    match /friend_requests/{requestId} {

      allow get: if signedIn()
        && (
          !exists(
            /databases/$(database)/documents/friend_requests/$(requestId)
          )
          || resource.data.senderId
            == request.auth.uid
          || resource.data.receiverId
            == request.auth.uid
        );

      allow list: if signedIn()
        && (
          resource.data.senderId
            == request.auth.uid
          || resource.data.receiverId
            == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.keys()
          .hasAll([
            'senderId',
            'receiverId',
            'createdAt'
          ])
        && request.resource.data.keys()
          .hasOnly([
            'senderId',
            'receiverId',
            'createdAt'
          ])
        && request.resource.data.senderId
          == request.auth.uid
        && request.resource.data.receiverId
          is string
        && request.resource.data.senderId
          != request.resource.data.receiverId
        && validPairId(
          requestId,
          request.resource.data.senderId,
          request.resource.data.receiverId
        )
        && request.resource.data.createdAt
          == request.time
        && exists(
          /databases/$(database)/documents/users/$(request.resource.data.senderId)
        )
        && exists(
          /databases/$(database)/documents/users/$(request.resource.data.receiverId)
        )
        && !exists(
          /databases/$(database)/documents/friendships/$(requestId)
        );

      allow update: if false;

      allow delete: if signedIn()
        && (
          resource.data.senderId
            == request.auth.uid
          || resource.data.receiverId
            == request.auth.uid
        );
    }

    // ==================================================
    // friendships
    // ==================================================

    match /friendships/{friendshipId} {

      allow get: if signedIn()
        && (
          !exists(
            /databases/$(database)/documents/friendships/$(friendshipId)
          )
          || request.auth.uid
            in resource.data.userIds
        );

      allow list: if signedIn()
        && request.auth.uid
          in resource.data.userIds;

      allow create: if signedIn()
        && request.resource.data.keys()
          .hasAll([
            'userIds',
            'createdAt'
          ])
        && request.resource.data.keys()
          .hasOnly([
            'userIds',
            'createdAt'
          ])
        && request.resource.data.userIds
          is list
        && request.resource.data.userIds
          .size() == 2
        && request.resource.data.userIds[0]
          != request.resource.data.userIds[1]
        && validPairId(
          friendshipId,
          request.resource.data.userIds[0],
          request.resource.data.userIds[1]
        )
        && request.resource.data.createdAt
          == request.time
        && exists(
          /databases/$(database)/documents/friend_requests/$(friendshipId)
        )
        && get(
          /databases/$(database)/documents/friend_requests/$(friendshipId)
        ).data.receiverId
          == request.auth.uid
        && request.resource.data.userIds
          .hasAll([
            get(
              /databases/$(database)/documents/friend_requests/$(friendshipId)
            ).data.senderId,
            get(
              /databases/$(database)/documents/friend_requests/$(friendshipId)
            ).data.receiverId
          ]);

      allow update: if false;

      allow delete: if signedIn()
        && request.auth.uid
          in resource.data.userIds;
    }

    // ==================================================
    // locations
    // ==================================================

    match /locations/{userId} {

      allow get: if isOwner(userId)
        || isFriend(userId);

      allow list: if false;

      allow create, update:
        if isOwner(userId)
        && validLocation(
          request.resource.data
        )
        && request.resource.data.updatedAt
          == request.time
        && getAfter(
          /databases/$(database)/documents/users/$(userId)
        ).data.sharingEnabled == true;

      allow delete: if isOwner(userId);
    }

    // ==================================================
    // その他
    // ==================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}